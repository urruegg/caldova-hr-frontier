{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "kind",
    "generatedAtUtc",
    "sourceCommit",
    "machine",
    "publicTenantKey",
    "intentDigest",
    "stateDigest",
    "toolIdentities",
    "providerContexts",
    "components",
    "prerequisites",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "$ref": "#/$defs/runId" },
    "kind": { "$ref": "#/$defs/stage" },
    "generatedAtUtc": { "$ref": "#/$defs/timestamp" },
    "sourceCommit": { "$ref": "#/$defs/sourceCommit" },
    "machine": { "$ref": "#/$defs/machine" },
    "publicTenantKey": { "$ref": "#/$defs/publicTenantKey" },
    "intentDigest": { "$ref": "#/$defs/digest" },
    "stateDigest": { "$ref": "#/$defs/digest" },
    "toolIdentities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/toolIdentity" }
    },
    "providerContexts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/providerContext" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/component" }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/prerequisite" }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "stage": {
      "enum": [
        "Workstation",
        "PrivateBoundary",
        "Foundation",
        "DevDelivery",
        "ReadBack",
        "Acceptance",
        "TenantReplica"
      ]
    },
    "stableId": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "publicTenantKey": { "type": "string", "pattern": "^tenant[0-9]+$" },
    "status": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
    "classification": {
      "enum": ["NoChange", "Create", "Update", "Manual", "Blocked", "Refused"]
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machineId", "platform"],
      "properties": {
        "machineId": { "$ref": "#/$defs/name" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "providerContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "contextId", "status", "digest"],
      "properties": {
        "provider": { "$ref": "#/$defs/name" },
        "contextId": { "$ref": "#/$defs/stableId" },
        "status": { "$ref": "#/$defs/status" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "resourceType",
        "classification",
        "targetStableId",
        "ownedPropertiesDigest",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "provider": { "$ref": "#/$defs/name" },
        "resourceType": { "$ref": "#/$defs/name" },
        "classification": { "$ref": "#/$defs/classification" },
        "targetStableId": { "$ref": "#/$defs/stableId" },
        "ownedPropertiesDigest": { "$ref": "#/$defs/digest" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "inputDigest", "evidenceDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "status": { "$ref": "#/$defs/status" },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
