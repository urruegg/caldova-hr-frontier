{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "executionManifestDigest",
    "approverRole",
    "approvedAtUtc",
    "expiresAtUtc",
    "scope",
    "status"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "$ref": "#/$defs/runId" },
    "executionManifestDigest": { "$ref": "#/$defs/digest" },
    "approverRole": { "$ref": "#/$defs/name" },
    "approvedAtUtc": { "$ref": "#/$defs/timestamp" },
    "expiresAtUtc": { "$ref": "#/$defs/timestamp" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    },
    "status": { "const": "Approved" }
  },
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" }
  }
}
