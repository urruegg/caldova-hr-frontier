{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAtUtc",
    "expiresAtUtc",
    "sourceCommit",
    "evidenceRoot",
    "publicTenantKey",
    "intentDigest",
    "stateDigest",
    "selectedStages",
    "prerequisiteResults",
    "machine",
    "operator",
    "toolIdentities",
    "providerContexts",
    "prerequisites",
    "actions",
    "digest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "$ref": "#/$defs/runId" },
    "generatedAtUtc": { "$ref": "#/$defs/timestamp" },
    "expiresAtUtc": { "$ref": "#/$defs/timestamp" },
    "sourceCommit": { "$ref": "#/$defs/sourceCommit" },
    "evidenceRoot": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "publicTenantKey": { "$ref": "#/$defs/publicTenantKey" },
    "intentDigest": { "$ref": "#/$defs/digest" },
    "stateDigest": { "$ref": "#/$defs/digest" },
    "selectedStages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stage" }
    },
    "prerequisiteResults": {
      "type": "array",
      "maxItems": 1,
      "items": { "$ref": "#/$defs/prerequisiteResult" }
    },
    "machine": { "$ref": "#/$defs/machine" },
    "operator": { "$ref": "#/$defs/operator" },
    "toolIdentities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/toolIdentity" }
    },
    "providerContexts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/providerContext" }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/prerequisite" }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/action" }
    },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "stage": {
      "enum": ["Workstation", "PrivateBoundary", "Foundation", "DevDelivery", "ReadBack", "Acceptance", "TenantReplica"]
    },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "stableId": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "publicTenantKey": { "type": "string", "pattern": "^tenant[0-9]+$" },
    "status": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
    "classification": {
      "enum": ["NoChange", "Create", "Update", "Manual", "Blocked", "Refused"]
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["machineId", "platform"],
      "properties": {
        "machineId": { "$ref": "#/$defs/name" },
        "platform": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatorId", "role"],
      "properties": {
        "operatorId": { "$ref": "#/$defs/name" },
        "role": { "$ref": "#/$defs/name" }
      }
    },
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "providerContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "contextId", "status", "digest"],
      "properties": {
        "provider": { "$ref": "#/$defs/name" },
        "contextId": { "$ref": "#/$defs/stableId" },
        "status": { "$ref": "#/$defs/status" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "inputDigest", "evidenceDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "status": { "$ref": "#/$defs/status" },
        "inputDigest": { "$ref": "#/$defs/digest" },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "prerequisiteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "status",
        "classification",
        "phaseManifestDigest",
        "phaseSummaryDigest",
        "intentDigest",
        "stateDigest"
      ],
      "properties": {
        "stage": { "$ref": "#/$defs/stage" },
        "status": { "const": "Passed" },
        "classification": { "enum": ["NoChange", "Changed"] },
        "phaseManifestDigest": { "$ref": "#/$defs/digest" },
        "phaseSummaryDigest": { "$ref": "#/$defs/digest" },
        "intentDigest": { "$ref": "#/$defs/digest" },
        "stateDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "classification",
        "targetStableId",
        "absencePredicate",
        "desiredPropertiesDigest",
        "preconditionDigest",
        "prerequisiteActionIds",
        "adapter",
        "shouldProcessTarget",
        "expectedPostcondition",
        "recovery",
        "evidenceProjection"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "provider": { "$ref": "#/$defs/name" },
        "classification": { "$ref": "#/$defs/classification" },
        "targetStableId": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "absencePredicate": { "type": "string", "minLength": 1, "maxLength": 512 },
        "desiredPropertiesDigest": { "$ref": "#/$defs/digest" },
        "preconditionDigest": { "$ref": "#/$defs/digest" },
        "prerequisiteActionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        },
        "adapter": { "$ref": "#/$defs/name" },
        "shouldProcessTarget": { "type": "string", "minLength": 1, "maxLength": 512 },
        "expectedPostcondition": { "type": "string", "minLength": 1, "maxLength": 512 },
        "recovery": { "type": "string", "minLength": 1, "maxLength": 512 },
        "evidenceProjection": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        }
      }
    }
  }
}
