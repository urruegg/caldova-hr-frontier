{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private backup declaration (not encryption or attendance verification)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "publicTenantKey", "createdAtUtc", "encryptionProvider", "containerLabel", "intentEntry", "stateEntry", "restoreTest"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "publicTenantKey": { "type": "string", "pattern": "^tenant[1-9][0-9]*$" },
    "createdAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$" },
    "encryptionProvider": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "containerLabel": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "intentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalName", "included", "encrypted"],
      "properties": {
        "logicalName": { "type": "string", "const": "intent" },
        "included": { "type": "boolean", "const": true },
        "encrypted": { "type": "boolean", "const": true }
      }
    },
    "stateEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logicalName", "included", "encrypted"],
      "properties": {
        "logicalName": { "type": "string", "const": "state" },
        "included": { "type": "boolean", "const": true },
        "encrypted": { "type": "boolean", "const": true }
      }
    },
    "restoreTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["testedAtUtc", "separateRoot", "intentEqual", "stateEqual", "result"],
      "properties": {
        "testedAtUtc": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$" },
        "separateRoot": { "type": "boolean", "const": true },
        "intentEqual": { "type": "boolean", "const": true },
        "stateEqual": { "type": "boolean", "const": true },
        "result": { "type": "string", "const": "Passed" }
      }
    }
  }
}
