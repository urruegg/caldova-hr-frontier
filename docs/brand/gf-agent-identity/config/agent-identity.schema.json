{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GF HR agent identity",
  "type": "object",
  "required": [
    "version",
    "naming",
    "environments",
    "poAreas",
    "agents"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "naming": {
      "type": "object",
      "required": [
        "displayTemplate",
        "maxDisplayLength",
        "maxBaseLength",
        "publisherPrefix",
        "solutionPrefix"
      ],
      "properties": {
        "publisherPrefix": {
          "enum": [
            "gf",
            "gfhr"
          ]
        },
        "maxDisplayLength": {
          "const": 30
        }
      }
    },
    "environments": {
      "type": "object",
      "required": [
        "DEV",
        "TEST",
        "PROD"
      ]
    },
    "poAreas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "token",
          "code",
          "processOwner"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9]*$"
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "journey",
          "po",
          "domain",
          "kind",
          "glyph",
          "shortDescription",
          "fullDescription"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D[1-6]-(LEAD|A[0-9]{2})$"
          },
          "journey": {
            "enum": [
              "D1",
              "D2",
              "D3",
              "D4",
              "D5",
              "D6"
            ]
          },
          "po": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9 '\\-]*$"
          },
          "scope": {
            "type": "string",
            "pattern": "^([A-Z]{2})?$"
          },
          "kind": {
            "enum": [
              "copilot-studio",
              "ess",
              "repository-agent"
            ]
          },
          "glyph": {
            "type": "string"
          },
          "shortDescription": {
            "type": "string",
            "maxLength": 72
          },
          "fullDescription": {
            "type": "string",
            "maxLength": 3900
          },
          "overrides": {
            "type": "object",
            "properties": {
              "schemaName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "solutionUniqueName": {
                "type": "string"
              },
              "slug": {
                "type": "string"
              }
            }
          },
          "derived": {
            "type": "object",
            "description": "Generated by scripts/build_identity_assets.py - do not edit"
          }
        }
      }
    }
  }
}
